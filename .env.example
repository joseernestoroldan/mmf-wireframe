# PayPal configuration for the donation gateway.
# Copy this file to .env.local and fill in your own values.
# Restart `npm run dev` after changing these — Next.js inlines them at startup.

# Public client ID from https://developer.paypal.com → Apps & Credentials → REST API app.
# Use the Sandbox id while testing, then swap in the Live one for production.
# Without it the donation form renders a "Checkout isn't connected yet" notice.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Subscription plan id used for monthly gifts (I-... id).
# PayPal dashboard → Payments → Subscriptions → create Product → create Plan
# (Monthly cycle, fixed price, infinite cycles) → activate → copy the plan id.
# The plan fixes the billed amount; without it the monthly option shows a notice.
NEXT_PUBLIC_PAYPAL_PLAN_ID=
